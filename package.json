{
  "name": "epb-fire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "setup:users": "node scripts/setup-users.mjs supabase/seed/users.json",
    "seed:demo": "node --experimental-strip-types scripts/gen-demo-seed.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "load:layers": "node scripts/load-layers.mjs",
    "port:layers": "python scripts/port_fire_layers.py"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@turf/area": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/length": "^7.4.0",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "lucide-preact": "^1.61.0",
    "preact": "^11.0.1",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}